<?xml version="1.0" encoding="utf-8"?>
<!-- The manifest used to point android:icon straight at the logo PNG. A raw
     bitmap gets the launcher's legacy treatment on Android 8+: it is shrunk
     into a system-drawn backdrop, which is why the icon looked small, and the
     adaptive mask then cropped the outer third of artwork that already filled
     95% of its canvas. A real adaptive icon fixes both. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
